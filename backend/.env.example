# Copy this file to .env and adjust if needed.

# Your fine-tuned model on Hugging Face Hub (check the exact repo name on
# your huggingface.co profile -- it can differ from what you typed in
# push_to_hub() if HF renamed/redirected it).
MODEL_REPO=lohithg8408/content-moderation

# Local dev: SQLite, zero setup.
DATABASE_URL=sqlite:///./dev.db

# Production (Render): set DATABASE_URL to your Supabase connection string
# as an environment variable in the Render dashboard, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
