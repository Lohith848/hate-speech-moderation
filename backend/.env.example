# Copy this file to .env and adjust if needed.

# Your fine-tuned model, QUANTIZED to fit a free-tier host (ONNX INT8).
# Produced by running backend/export_and_quantize_model.ipynb in Colab.
MODEL_REPO=lohithg8408/content-moderation-onnx-int8

# Local dev: SQLite, zero setup.
DATABASE_URL=sqlite:///./dev.db

# Production (Render): Use Supabase's SESSION POOLER connection string,
# not the direct db.<ref>.supabase.co one (which is IPv6-only and fails on Render).
# e.g. postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Note: If password contains special characters like '@', URL-encode it (e.g. '%40').
